# Cloudflare Pages 301 redirects
# Old URLs → new /zh-cn/ URLs (preserves SEO link equity)
# English users can manually navigate to /en/ via the language switcher.

/index.html        /zh-cn/             301
/about.html        /zh-cn/about         301
/faq.html          /zh-cn/faq          301
/contact.html      /zh-cn/contact      301
/pricing.html      /zh-cn/pricing      301
/404.html          /zh-cn/404          301

# Subdirectory wildcards (splat captures the rest of the path)
/blog/*            /zh-cn/blog/:splat   301
/city/*            /zh-cn/city/:splat   301
/tools/*           /zh-cn/tools/:splat  301
/usa-to-china/*    /zh-cn/usa-to-china/:splat     301
/japan-to-china/*  /zh-cn/japan-to-china/:splat   301
/korea-to-china/*  /zh-cn/korea-to-china/:splat   301
/europe-to-china/* /zh-cn/europe-to-china/:splat  301
/canada-to-china/* /zh-cn/canada-to-china/:splat  301
/australia-to-china/* /zh-cn/australia-to-china/:splat 301
/seasia-to-china/* /zh-cn/seasia-to-china/:splat  301
/student-luggage/* /zh-cn/student-luggage/:splat  301
/usa-moving-to-china/* /zh-cn/usa-moving-to-china/:splat 301

# Bare path → clean URL (matches canonical)
/about             /zh-cn/about         301
/faq               /zh-cn/faq           301
/contact           /zh-cn/contact       301
/pricing           /zh-cn/pricing       301